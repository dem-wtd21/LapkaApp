<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/background_gradient">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Новая запись"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etRecordTitleInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Что сделали (например, Прививка)"
        android:inputType="textCapSentences"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etRecordDateInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Дата (например, 28.10.2026)"
        android:inputType="date"
        android:padding="12dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnSaveRecord"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Сохранить запись"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1E293B"
        android:textSize="16sp"
        android:textStyle="bold"/>
</LinearLayout>