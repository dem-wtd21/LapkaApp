<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="24dp"
android:background="@drawable/background_gradient">

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Мои питомцы"
    android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="#000000"
    android:layout_marginBottom="24dp"/>

<!-- карточка питомца с фото и данными -->
<LinearLayout
    android:id="@+id/cardPet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:drawable/dialog_holo_light_frame"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="24dp">

    <!-- место для фотографии питомца -->
    <ImageView
        android:id="@+id/ivPetPhoto"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/koshak"
        android:background="#E3EBF5"
        android:padding="8dp"/>

    <!-- текстовые данные питомца -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Кличка питомца"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPetInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Порода, возраст"
            android:textSize="14sp"
            android:textColor="#757575"/>
    </LinearLayout>
</LinearLayout>
    <!-- блок меню разделов ухода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnMedicalCard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🏥 Медкарта питомца"
            android:textColor="#1E293B"
            android:backgroundTint="#E3EBF5"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnReminders"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⏰ Заботы и напоминания"
            android:textColor="#1E293B"
            android:backgroundTint="#E3EBF5"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnFeeding"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🍗 Рацион питания"
            android:textColor="#1E293B"
            android:backgroundTint="#E3EBF5"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnShopping"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🛒 Список покупок"
            android:textColor="#1E293B"
            android:backgroundTint="#E3EBF5"
            android:textStyle="bold"/>
    </LinearLayout>
<Button
    android:id="@+id/btnAddPet"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:text="Добавить питомца"
    android:textColor="#FFFFFF"
    android:backgroundTint="#1E293B"
    android:textSize="16sp"
    android:textStyle="bold"/>

</LinearLayout>
